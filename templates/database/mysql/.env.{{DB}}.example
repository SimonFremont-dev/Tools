# {{PROJECT}} / mysql credentials - merge into .env (`make env`); .env is gitignored, never commit real values
{{DBENV}}_DATABASE_URL=mysql://dev:dev@localhost:3306/{{PROJECT}}
{{DBENV}}_STAGING_DATABASE_URL=mysql://user:password@staging-host:3306/{{PROJECT}}
MYSQL_PASSWORD=dev
MYSQL_ROOT_PASSWORD=dev
