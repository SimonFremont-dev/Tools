# {{PROJECT}} / postgres credentials - merge into .env (`make env`); .env is gitignored, never commit real values
{{DBENV}}_DATABASE_URL=postgres://dev:dev@localhost:5432/{{PROJECT}}?sslmode=disable
{{DBENV}}_STAGING_DATABASE_URL=postgres://user:password@staging-host:5432/{{PROJECT}}?sslmode=require
POSTGRES_PASSWORD=dev
