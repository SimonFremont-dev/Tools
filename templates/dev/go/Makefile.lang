SETUP_CMD = go mod download
RUN_CMD = go run ./cmd/{{PROJECT}}
TEST_CMD = go test ./...
LINT_CMD = golangci-lint run ./...
FMT_CMD = golangci-lint fmt ./...
FMT_CHECK_CMD = golangci-lint fmt --diff ./...
SECURITY_CMD = govulncheck ./...
BUILD_CMD = go build -o bin/{{PROJECT}} ./cmd/{{PROJECT}}
CLEAN_CMD = rm -rf bin coverage.out

.PHONY: release lint-report
release:
	goreleaser release --snapshot --clean

lint-report:
	./scripts/lint-report.sh
