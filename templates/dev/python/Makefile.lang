SETUP_CMD = python -m venv .venv && . .venv/bin/activate && pip install -e .
RUN_CMD = python main.py
TEST_CMD = python -m pytest
LINT_CMD = ruff check . && mypy .
FMT_CMD = ruff format .
FMT_CHECK_CMD = ruff format --check .
SECURITY_CMD = pip-audit
BUILD_CMD = python -m build
CLEAN_CMD = rm -rf dist build *.egg-info
